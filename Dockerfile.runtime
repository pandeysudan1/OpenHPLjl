FROM julia:1.12.7-bookworm

WORKDIR /work

ENTRYPOINT []

ENV JULIA_PKG_PRECOMPILE_AUTO=0

# Cache the package layer independently from example-only changes.
COPY Project.toml ./
COPY src ./src

# Keep package resolution/precompilation and package loading in separate Julia
# processes. This avoids the loaded-stdlib version mismatch seen when Pkg and
# the SciML stack are loaded in the same process.
RUN /usr/local/julia/bin/julia --project=. -e 'using Pkg; Pkg.instantiate(); Pkg.precompile()'
RUN /usr/local/julia/bin/julia --project=. -e 'using OpenHPLjl, ModelingToolkit, OrdinaryDiffEq, SciMLBase; println("OPENHPLJL_IMAGE_READY")'

# Example-only changes must not overwrite src/ or Project.toml after precompile,
# otherwise Julia invalidates the local package cache at container runtime.
COPY examples ./examples

CMD ["bash", "-lc", "set -euxo pipefail; echo OPENHPLJL_RUNTIME_START; /usr/local/julia/bin/julia --version; /usr/local/julia/bin/julia --project=. examples/FCR/run.jl; echo OPENHPLJL_COMPLETE; sleep infinity"]
