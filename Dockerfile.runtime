FROM julia:1.12.7-bookworm

WORKDIR /work

ENTRYPOINT []

CMD ["bash", "-lc", "set -euxo pipefail; echo OPENHPLJL_RUNTIME_START; /usr/local/julia/bin/julia --version; command -v git >/dev/null 2>&1 || (apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq git ca-certificates); rm -rf /tmp/OpenHPLjl; git clone --depth 1 --branch main https://github.com/pandeysudan1/OpenHPLjl.git /tmp/OpenHPLjl; cd /tmp/OpenHPLjl; echo OPENHPLJL_COMMIT=$(git rev-parse HEAD); JULIA_PKG_PRECOMPILE_AUTO=0 /usr/local/julia/bin/julia --project=. -e 'using Pkg; Pkg.instantiate()'; echo OPENHPLJL_INSTANTIATE_DONE; /usr/local/julia/bin/julia --project=. examples/FCR/run.jl; echo OPENHPLJL_COMPLETE; sleep infinity"]
