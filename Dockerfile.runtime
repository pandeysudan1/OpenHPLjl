FROM julia:1.12.7-bookworm

WORKDIR /work

ENTRYPOINT []

ENV JULIA_PKG_PRECOMPILE_AUTO=0

# Bake the exact Railway/GitHub source snapshot into the image so runtime does
# not clone or rebuild the Julia environment on every deployment.
COPY . .

RUN /usr/local/julia/bin/julia --project=. -e 'using Pkg; Pkg.instantiate(); Pkg.precompile(); using OpenHPLjl, ModelingToolkit, OrdinaryDiffEq, SciMLBase; println("OPENHPLJL_IMAGE_READY")'

CMD ["bash", "-lc", "set -euxo pipefail; echo OPENHPLJL_RUNTIME_START; /usr/local/julia/bin/julia --version; echo OPENHPLJL_COMMIT_IMAGE_BUILD; /usr/local/julia/bin/julia --project=. examples/FCR/run.jl; echo OPENHPLJL_COMPLETE; sleep infinity"]
